# Postgres connection string (local: `npx prisma dev --name salek`; production: Neon)
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
# Only needed for `prisma migrate dev` against the local dev server
SHADOW_DATABASE_URL=""
# Set to 1 for the local `prisma dev` server; leave empty in production
DATABASE_POOL_MAX=""

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# First admin account, created by `npm run db:seed` (change the password after first login)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cloudinary (photo + CV uploads). Dashboard → Settings → API Keys.
# The API secret stays on the server; never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# All uploads go into this folder; only files in it can be saved or deleted.
CLOUDINARY_FOLDER="portfolio"
